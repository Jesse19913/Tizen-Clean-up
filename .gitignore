# build output
dist/
*.wgt
*.tpk
.buildResult/

# logs
logs/
*.log
npm-debug.log*

# dependencies
node_modules/

# signing material — never commit a Tizen author/distributor certificate
*.p12
*.pfx
*.pem
*.key
*.cer
*.crt
author-signature.xml
signature*.xml
.sign/
.tizen-cli-config

# secrets
.env
.env.*

# native helper build output (device-specific; build it yourself)
native/**/bin/
native/**/obj/
native/build/

# never publish a device baseline or a conversation transcript
*-baseline.json
original-*.json
native-snapshot.json
*conversation*.pdf

# local agent + editor settings
.claude/settings.local.json
.vscode/
.idea/
*.swp
*~

# macOS
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
